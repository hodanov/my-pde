{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-version-pins.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/test-changed.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ai-agents@my-pde": true
  },
  "extraKnownMarketplaces": {
    "my-pde": {
      "source": {
        "source": "github",
        "repo": "hodanov/my-pde"
      }
    }
  }
}
