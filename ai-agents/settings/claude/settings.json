{
  "agentPushNotifEnabled": true,
  "model": "claude-opus-5-5[1m]",
  "env": {
    "SKILL_OBSERVE_HOME": "~/workspace/my-pde"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(actionlint *)",
      "Bash(base64 *)",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(docker compose *)",
      "Bash(docker container exec nvim-dev *)",
      "Bash(docker cp * nvim-dev:/root/.config/nvim/*)",
      "Bash(docker events *)",
      "Bash(docker image ls *)",
      "Bash(du *)",
      "Bash(echo *)",
      "Bash(gcloud artifacts docker tags list *)",
      "Bash(git *)",
      "Bash(gh auth status *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr status *)",
      "Bash(gh pr view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh search *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(go test *)",
      "Bash(go tool *)",
      "Bash(go build *)",
      "Bash(gofmt *)",
      "Bash(golangci-lint run *)",
      "Bash(go mod *)",
      "Bash(goimports *)",
      "Bash(grep *)",
      "Bash(gzcat *)",
      "Bash(hadolint *)",
      "Bash(head *)",
      "Bash(hugo *)",
      "Bash(jq *)",
      "Bash(kubectl kustomize *)",
      "Bash(ls *)",
      "Bash(markdownlint-cli2 *)",
      "Bash(mise run *)",
      "Bash(mise tasks *)",
      "Bash(mise which *)",
      "Bash(mkdir -p *)",
      "Bash(nl *)",
      "Bash(npm audit *)",
      "Bash(npm ls *)",
      "Bash(npm run lint)",
      "Bash(npm run test *)",
      "Bash(npm view *)",
      "Bash(npx markdownlint-cli2 *)",
      "Bash(npx playwright *)",
      "Bash(npx prettier *)",
      "Bash(pinact *)",
      "Bash(prettier *)",
      "Bash(ps aux)",
      "Bash(rg *)",
      "Bash(shellcheck *)",
      "Bash(shfmt *)",
      "Bash(sleep *)",
      "Bash(sort *)",
      "Bash(stylua *)",
      "Bash(tail *)",
      "Bash(terraform fmt *)",
      "Bash(terraform init *)",
      "Bash(terraform plan *)",
      "Bash(terraform providers *)",
      "Bash(terraform show *)",
      "Bash(terraform validate *)",
      "Bash(terraform version)",
      "Bash(tflint *)",
      "Bash(tombi *)",
      "Bash(tr *)",
      "Bash(command -v *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(zizmor *)",
      "Edit(~/workspace/my-pde/ai-agents/skills/*/observations/**)",
      "Read(~/.zshrc)",
      "Read(~/.codex/**)",
      "Read(~/.cursor/**)",
      "Read(~/.claude/**)",
      "Read(~/workspace/**)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:hub.docker.com)",
      "WebSearch"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(git -c *)",
      "Bash(git config *)"
    ],
    "deny": [
      "Bash(chmod 777 *)",
      "Bash(rm -rf *)",
      "Bash(wget *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./secrets/**)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.crt)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/credentials*)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/context-anchor-save.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/toolchain-doctor.sh"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/context-anchor-restore.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/git-state.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-dangerous-bash.sh"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/permission-ledger.sh",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/goimports.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/markdown-format.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/shfmt.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/prettier.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/stylua.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/tombi.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/lint-changed.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/skill-observe-nudge.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-macos.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-macos.sh"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-create.sh"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "mise *",
      "terraform *",
      "tflint *",
      "go *",
      "git *",
      "gh *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/Library/Caches/go-build",
        "~/Library/Caches/golangci-lint",
        "~/go/pkg/mod",
        "~/.npm",
        " ~/.cache/pre-commit"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "proxy.golang.org",
        "sum.golang.org",
        "registry.npmjs.org"
      ]
    }
  },
  "askUserQuestionTimeout": "10m",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "editorMode": "vim"
}
